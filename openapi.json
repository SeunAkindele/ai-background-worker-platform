  "components": {
    "schemas": {
      "Body_create_job_with_upload_uploads_job_post": {
        "properties": {
          "job_type": {
            "$ref": "#/components/schemas/JobType"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "priority": {
            "$ref": "#/components/schemas/JobPriority",
            "default": "normal"
          }
        },
        "type": "object",
        "required": [
          "job_type",
          "file"
        ],
        "title": "Body_create_job_with_upload_uploads_job_post"
      },
      "Body_upload_file_uploads_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "purpose": {
            "$ref": "#/components/schemas/FilePurpose"
          }
        },
        "type": "object",
        "required": [
          "file",
          "purpose"
        ],
        "title": "Body_upload_file_uploads_post"
      },
      "ChunkListResponse": {
        "properties": {
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/ChunkResponse"
            },
            "type": "array",
            "title": "Chunks"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          }
        },
        "type": "object",
        "required": [
          "chunks",
          "total",
          "document_id"
        ],
        "title": "ChunkListResponse"
      },
      "ChunkResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "chunk_index": {
            "type": "integer",
            "title": "Chunk Index"
          },
          "token_count": {
            "type": "integer",
            "title": "Token Count"
          },
          "level": {
            "type": "string",
            "title": "Level",
            "default": "child"
          },
          "parent_chunk_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Chunk Id"
          },
          "metadata_": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "document_id",
          "content",
          "chunk_index",
          "token_count",
          "created_at"
        ],
        "title": "ChunkResponse"
      },
      "DashboardResponse": {
        "properties": {
          "total_jobs": {
            "type": "integer",
            "title": "Total Jobs"
          },
          "pending_jobs": {
            "type": "integer",
            "title": "Pending Jobs"
          },
          "processing_jobs": {
            "type": "integer",
            "title": "Processing Jobs"
          },
          "completed_jobs": {
            "type": "integer",
            "title": "Completed Jobs"
          },
          "failed_jobs": {
            "type": "integer",
            "title": "Failed Jobs"
          },
          "avg_processing_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Processing Seconds"
          },
          "slowest_job_types": {
            "items": {
              "$ref": "#/components/schemas/JobTypeStats"
            },
            "type": "array",
            "title": "Slowest Job Types"
          },
          "queue_size": {
            "type": "integer",
            "title": "Queue Size"
          },
          "workers": {
            "$ref": "#/components/schemas/WorkerHealthResponse"
          }
        },
        "type": "object",
        "required": [
          "total_jobs",
          "pending_jobs",
          "processing_jobs",
          "completed_jobs",
          "failed_jobs",
          "avg_processing_seconds",
          "slowest_job_types",
          "queue_size",
          "workers"
        ],
        "title": "DashboardResponse"
      },
      "DocumentIngestRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "description": "Human-readable name for this document"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content",
            "description": "The full text content to ingest"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Where this document came from: 'text', 'upload', 'url'",
            "default": "text"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
