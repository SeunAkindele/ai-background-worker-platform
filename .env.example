# === Local Development (running outside Docker) ===
# DATABASE_URL=postgresql://macbook@localhost:5432/ai_worker_platform

# === Docker Development (set automatically by docker-compose.yml) ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_worker_platform
REDIS_URL=redis://localhost:6379/0

APP_ENV=development
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_PENDING_JOBS_PER_USER=50

# Local: relative path. Docker: absolute path (set in compose).
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=52428800
UPLOAD_CHUNK_SIZE=8192

# Worker identity for heartbeats (set per Compose service; default for local single worker)
# WORKER_TYPE=all

# MCP web search endpoint (required)
MCP_WEB_URL=http://localhost:8080/mcp